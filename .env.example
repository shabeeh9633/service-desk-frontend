# ─────────────────────────────────────────────────────────────────────────────
# IT Service Desk — Frontend Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit real secrets to git.
# ─────────────────────────────────────────────────────────────────────────────

# Google OAuth Client ID
# Get one at: https://console.cloud.google.com/apis/credentials
# → Create credentials → OAuth 2.0 Client ID → Web application
# → Authorized JavaScript origins: http://localhost:5173
# → Authorized redirect URIs: (leave blank for GSI popup mode)
#
# Leave empty to hide the Google Sign-In button entirely.
VITE_GOOGLE_CLIENT_ID=

VITE_API_URL=https://service-desk-backend-4ldo.onrender.com
